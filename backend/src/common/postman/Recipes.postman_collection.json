{
  "info": {
    "_postman_id": "bc3b3bfe-036b-4eaf-bb94-8edc95788113",
    "name": "FreshTrack D2 — Recetas (Nayo)",
    "description": "Recetas con JWT. Configurar adminEmail y adminPassword de la cuenta administradora creada según AUTH.md y masterProductId real. Ejecutar toda la colección en orden en una base de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "masterProductId",
      "value": "1"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin.auth@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "recipeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A - Registrar usuario de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Usuario Postman\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"userEmail\", \"prueba-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
              "pm.collectionVariables.set(\"userPassword\", pm.variables.replaceIn(\"{{$guid}}\") + \"Aa1!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken); pm.collectionVariables.set(\"donorId\", pm.response.json().user.id); }",
              "pm.test(\"Registro sin privilegios\", () => pm.expect(pm.response.json().user.role).to.eql(\"user\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "B - Login del usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "C - Login administrador previamente configurado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);",
              "pm.test(\"Cuenta administradora\", () => pm.expect(pm.response.json().user.role).to.eql(\"admin\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 — Consultar recetas aprobadas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/recipes",
        "description": "Usa el token del usuario."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));",
              "pm.test(\"Solo recetas aprobadas\", () => pm.response.json().forEach(r => pm.expect(r.moderationStatus).to.eql(\"approved\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Crear receta válida (pending)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recipes",
        "description": "Usa el token del usuario.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Arroz con vegetales\",\n  \"prepTimeMins\": 25,\n  \"masterProductIds\": [\n    {{masterProductId}}\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set(\"recipeId\", String(data.id)); pm.test(\"Receta pendiente\", () => pm.expect(data.moderationStatus).to.eql(\"pending\")); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Rechazar DTO sin ingredientes (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recipes",
        "description": "Usa el token del usuario.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Receta sin ingredientes\",\n  \"prepTimeMins\": 10,\n  \"masterProductIds\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400 por validación\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03b — Usuario no puede moderar (403)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recipes/{{recipeId}}/moderation",
        "description": "Un usuario normal recibe 403, aunque conozca el ID de la receta.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"moderationStatus\": \"approved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Aprobar receta pendiente (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recipes/{{recipeId}}/moderation",
        "description": "Usa el token del administrador.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"moderationStatus\": \"approved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.test(\"Aprobada\", () => pm.expect(pm.response.json().moderationStatus).to.eql(\"approved\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Moderación duplicada rechazada (409)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recipes/{{recipeId}}/moderation",
        "description": "Usa el token del administrador.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"moderationStatus\": \"rejected\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409 por estado previo\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Consultar recetas aprobadas después de moderar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/recipes",
        "description": "Usa el token del usuario."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Receta aprobada visible\", () => { const data=pm.response.json(); const id=Number(pm.collectionVariables.get(\"recipeId\")); pm.expect(data.some(r => r.id===id && r.moderationStatus===\"approved\")).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  }
}
