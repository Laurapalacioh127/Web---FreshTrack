{
  "info": {
    "name": "FreshTrack - Donations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden en base local de prueba. Configurar adminEmail, adminPassword y masterProductId seg\u00fan AUTH.md. Genera usuario, inventario y donaciones."
  },
  "variable": [
    {
      "key": "donorId",
      "value": "2"
    },
    {
      "key": "masterProductId",
      "value": "1"
    },
    {
      "key": "inventoryId",
      "value": ""
    },
    {
      "key": "donationId",
      "value": ""
    },
    {
      "key": "rejectedDonationId",
      "value": ""
    },
    {
      "key": "expiredInventoryId",
      "value": ""
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin.auth@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const date = new Date();",
          "date.setDate(date.getDate() + 7);",
          "pm.variables.set(\"expirationDate\", date.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "A - Registrar usuario de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Usuario Postman\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"userEmail\", \"prueba-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
              "pm.collectionVariables.set(\"userPassword\", pm.variables.replaceIn(\"{{$guid}}\") + \"Aa1!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken); pm.collectionVariables.set(\"donorId\", pm.response.json().user.id); }",
              "pm.test(\"Registro sin privilegios\", () => pm.expect(pm.response.json().user.role).to.eql(\"user\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "B - Login del usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "C - Login administrador previamente configurado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);",
              "pm.test(\"Cuenta administradora\", () => pm.expect(pm.response.json().user.role).to.eql(\"admin\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Crear alimento de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/inventory",
        "description": "Crea un alimento de prueba. Requiere usuarios y cat\u00e1logo del seed. Cambia los IDs si tu base tiene otros.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"masterProductId\": {{masterProductId}},\n  \"quantity\": 10,\n  \"expirationDate\": \"{{expirationDate}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"inventoryId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear donaci\u00f3n pendiente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"donationId\", pm.response.json().id);",
              "pm.test(\"Estado pendiente\", () => pm.expect(pm.response.json().donationStatus).to.eql(\"pending\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Listar pendientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/donations?status=pending",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar mis donaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/donations?donorId={{donorId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Ver detalle",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/donations/{{donationId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Usuario normal no puede aceptar",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations/{{donationId}}/status",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"accepted\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Admin acepta",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations/{{donationId}}/status",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"accepted\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Aceptada\", () => pm.expect(pm.response.json().donationStatus).to.eql(\"accepted\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Verificar descuento de inventario",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/inventory/{{inventoryId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Quedan 8 unidades\", () => pm.expect(pm.response.json().quantity).to.eql(8));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Impedir segunda revisi\u00f3n",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations/{{donationId}}/status",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Crear otra donaci\u00f3n",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"rejectedDonationId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Admin rechaza",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations/{{rejectedDonationId}}/status",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Rechazada\", () => pm.expect(pm.response.json().donationStatus).to.eql(\"rejected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Rechazar conserva el inventario",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/inventory/{{inventoryId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Siguen 8 unidades\", () => pm.expect(pm.response.json().quantity).to.eql(8));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Cantidad inv\u00e1lida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 0\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Stock insuficiente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 999\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Producto duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 2\n    },\n    {\n      \"inventoryId\": {{inventoryId}},\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Estado inv\u00e1lido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations/{{donationId}}/status",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Alimento vencido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/inventory",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"masterProductId\": {{masterProductId}},\n  \"quantity\": 3,\n  \"expirationDate\": \"2000-01-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"expiredInventoryId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "18 - No donar vencidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/donations",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"inventoryId\": {{expiredInventoryId}},\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  }
}
